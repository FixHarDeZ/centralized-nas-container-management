.DS_Store
# Matches both root .env and every <stack>/.env (gitignore patterns without a
# leading slash match at any directory depth). .env.example files are tracked.
.env
.env.deploy
secrets/vault.yaml
backup-pre-vault/
.htpasswd
__pycache__/
*.pyc
.superpowers/
.worktrees/
.tokensave/
.mimocode/
.pytest_cache/
.roo/
.ruff_cache/
.serena/

# headroom wrap runtime state (per-machine PIDs, not shared config)
.claude/.headroom_wrap_marker.json
.claude/.headroom_wrap_owners.json
.claude/.headroom_wrap_settings.lock
