{
  "name": "Shop Flow Studio",
  "active": false,
  "nodes": [
    {
      "name": "Every minute",
      "id": "every-minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "name": "Reconcile",
      "id": "reconcile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://host.docker.internal:5071/shop/automation/pending",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "name": "Shop Flow Studio"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "name": "Already terminal",
      "id": "already-terminal",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "already terminal0",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "already terminal1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "name": "Needs dispatch",
      "id": "needs-dispatch",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "needs dispatch0",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending_dispatch",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "name": "Start render",
      "id": "start-render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        80
      ],
      "parameters": {
        "url": "={{ 'http://host.docker.internal:5071/shop/automation/renders/' + $json.id + '/start' }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { revision: $json.revision, idempotency_key: 'shop-start:' + $json.id } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "name": "Shop Flow Studio"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "name": "Wait for render",
      "id": "wait-for-render",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1100,
        160
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      }
    },
    {
      "name": "Check render",
      "id": "check-render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        160
      ],
      "parameters": {
        "url": "={{ 'http://host.docker.internal:5071/shop/automation/renders/' + $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "name": "Shop Flow Studio"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "name": "Render finished",
      "id": "render-finished",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "render finished0",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "render finished1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "name": "Notify result",
      "id": "notify-result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -100
      ],
      "parameters": {
        "url": "http://host.docker.internal:5071/shop/automation/notifications",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $json.job_id, render_id: $json.id, milestone: $json.status, idempotency_key: 'shop-result:' + $json.id + ':' + $json.status } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpCustomAuth": {
          "name": "Shop Flow Studio"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Reconcile",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reconcile": {
      "main": [
        [
          {
            "node": "Already terminal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Already terminal": {
      "main": [
        [
          {
            "node": "Notify result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Needs dispatch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs dispatch": {
      "main": [
        [
          {
            "node": "Start render",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait for render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start render": {
      "main": [
        [
          {
            "node": "Wait for render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for render": {
      "main": [
        [
          {
            "node": "Check render",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check render": {
      "main": [
        [
          {
            "node": "Render finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render finished": {
      "main": [
        [
          {
            "node": "Notify result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "executionTimeout": 240,
    "timezone": "Asia/Bangkok"
  },
  "tags": []
}
